{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extension_name__",
  "version": "1.3.0",
  "description": "__MSG_extension_description__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Flovart Browser Import"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "externally_connectable": {
    "matches": [
      "https://flovart.avabbbb.com/*",
      "http://127.0.0.1:37522/*",
      "http://localhost:37522/*"
    ]
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
