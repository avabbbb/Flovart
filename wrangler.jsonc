// iris.avabbbb.com：Cloudflare Workers + 静态资源（网页版全静态）。
// 只有 /api/* 先进 Worker（worker/index.ts → /api/llm-proxy/* 交给 server/llmProxy.ts）；
// 其余请求由资源层直接返回、不计 Worker 调用，未命中的路径回落 index.html（SPA）。
// COOP/COEP 响应头由 public/_headers（构建后 dist/_headers）提供。
{
  "name": "iris",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
