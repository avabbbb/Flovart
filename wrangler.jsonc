{
  // Flovart on Cloudflare Workers (static assets + same-origin LLM proxy, free plan).
  // Build: VITE_BASE_PATH=/ npx vite build, then `npx wrangler deploy`.
  // CI: .github/workflows/deploy-cloudflare.yml deploys on every push to main.
  // Rollback: the old Pages project "flovart" (flovart-b5a.pages.dev) is kept.
  "name": "flovart",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* (the LLM proxy) must reach the Worker before the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "flovart.avabbbb.com", "custom_domain": true }]
}
