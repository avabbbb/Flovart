{
  "$schema": "https://flovart.local/schemas/dsh-plugin/assembly.v1.json",
  "schemaVersion": "1",
  "pluginId": "com.flovart.dsh-plugin",
  "pluginVersion": "0.1.0",
  "compatibleSets": [
    {
      "setId": "flovart-2026-08-rc8",
      "deepseekHarness": "0.2.2-rc.1",
      "deepseekHarnessCommit": "141eb6f",
      "node": "^22.19.0 || >=24.0.0",
      "flovartRuntime": ">=0.3.2",
      "flovartWebUI": ">=0.3.2",
      "operationSkill": "",
      "protocol": {
        "channel": "flovart-workspace-command",
        "version": 1
      }
    }
  ],
  "entrypoints": {
    "bundle": {
      "package": "@flovart/dsh-plugin",
      "patch": "./cordis.patch.yml",
      "clientEntry": "./client",
      "rowId": "flovart"
    },
    "workflowView": {
      "kind": "contextual-conversation-view",
      "slot": "conversation.view",
      "surface": "production",
      "badges": [
        "waiting",
        "error",
        "artifacts"
      ],
      "briefLedStart": false,
      "autoWorkspace": true,
      "sidebarEntry": true,
      "iframe": true,
      "iframeSrc": "/flovart-app/?embed=dsh#/app",
      "workspaceProxyPath": "/flovart-workspace",
      "webui": {
      "routePrefix": "/flovart-app",
      "root": "./webui",
      "bootstrapPath": "/flovart-app/api/bootstrap"
    }
    },
    "hostTools": {
      "kind": "cli-derivation",
      "commandList": "flovart command.list --json",
      "commandSchema": "flovart command.schema --command {command} --json",
      "bootstrap": "flovart ensure --json"
    }
  },
  "privacy": {
    "sessionBindingOnly": true,
    "noChatMirror": true,
    "noProviderSecrets": true,
    "noLongTermTokensInUrl": true,
    "workspaceTokenHostOnly": true
  },
  "degradation": {
    "pluginDisabled": "Operation Skill + CLI",
    "independentWindow": false
  }
}
