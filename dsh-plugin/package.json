{
  "name": "@flovart/dsh-plugin",
  "version": "0.1.0",
  "description": "Flovart Production Workspace plugin for DeepSeek Harness RC8: dsh bundle patch + host CLI tool derivation + contextual conversation.view and shell.overlay entries.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "webui",
    "cordis.patch.yml",
    "skill"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "profile:install": "node scripts/profile.mjs install",
    "profile:doctor": "node scripts/profile.mjs doctor",
    "profile:start": "node scripts/profile.mjs start",
    "profile:uninstall": "node scripts/profile.mjs uninstall",
    "build:webui": "node scripts/build-webui.mjs",
    "prepack": "node scripts/build-webui.mjs && node scripts/build.mjs",
    "test": "node --test test/tools.test.ts test/skillProvider.test.ts test/webui.test.ts test/workspaceTarget.test.ts test/policy.test.ts test/policyHook.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1"
  }
}
