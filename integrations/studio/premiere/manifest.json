{
  "manifestVersion": 5,
  "id": "com.flovart.studio.premiere",
  "name": "Flovart",
  "version": "0.3.2",
  "main": "index.html",
  "host": [{ "app": "premierepro", "minVersion": "25.6.0" }],
  "entrypoints": [
    {
      "type": "panel",
      "id": "flovartPanel",
      "label": "Flovart",
      "preferredDockedWidth": 360,
      "preferredDockedHeight": 540
    },
    { "type": "command", "id": "flovartOpenCanvas", "label": "打开 Flovart 画布" },
    { "type": "command", "id": "flovartGenerateFromSelection", "label": "用当前选择生成" }
  ]
}
