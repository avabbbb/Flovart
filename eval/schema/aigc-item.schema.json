{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flovart.dev/schema/aigc-item.schema.json",
  "title": "AigcItem",
  "description": "One multimodal AIGC eval item (eval/aigc/items/*.json). Conditions are grouped by role; checks are per-item, checkable QA questions. See eval/eval.md §4.1.",
  "type": "object",
  "required": ["id", "version", "domain", "scenario", "capabilities", "difficulty", "split", "prompt", "rubrics", "source"],
  "additionalProperties": false,
  "definitions": {
    "consent": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Why this asset may be used. person-consent = a real, identifiable person who agreed in writing (required for face_ref / voice cloning of a real person).",
          "enum": ["synthetic", "owned", "licensed", "public-domain", "cc0", "cc-by", "person-consent"]
        },
        "ref": { "type": "string", "minLength": 1, "description": "Where the consent / license evidence lives (contract id, URL, ticket). Never the document itself." },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "required": ["uri", "mime", "consent"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 3, "description": "Relative path, file://, https://, artifact:// or fixture:<name> (generated by `node eval/aigc/run.mjs fixtures`, never committed)." },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mime": { "type": "string", "pattern": "^(image|video|audio|text)/[a-z0-9.+-]+$" },
        "consent": { "$ref": "#/definitions/consent" },
        "durationSec": { "type": "number", "minimum": 0 },
        "transcript": { "type": "string" },
        "speakerId": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "assetList": { "type": "array", "items": { "$ref": "#/definitions/asset" }, "minItems": 1 },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": {
      "description": "active items count; withdrawn = removed from rates (e.g. an unstable grader, a broken asset) with a reason; retired = no longer discriminative.",
      "enum": ["active", "withdrawn", "retired"]
    },
    "statusReason": { "type": "string", "minLength": 1 },
    "domain": { "enum": ["t2i", "i2i-edit", "t2v", "i2v", "flf2v", "r2v", "v-edit", "v-extend", "digital-human", "tts", "agent-run"] },
    "scenario": {
      "description": "Use-case axis (SeedVideoBench 2.0 six scenarios).",
      "enum": ["ad", "fiction", "pgc", "consumer-effects", "social", "basic"]
    },
    "taskGroup": {
      "description": "Multimodal task group (SeedVideoBench 2.0): generate = plain T2X; reference / edit / extend / combine use condition assets.",
      "enum": ["generate", "reference", "edit", "extend", "combine"]
    },
    "capabilities": {
      "description": "Capability axis, dotted tags such as camera.dolly-in, subject.count, text.zh, audio.sync, narrative.multi-shot.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$" }
    },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "split": {
      "description": "dev = free to iterate prompts / rubrics on; test = reported; holdout = never shown to whoever tunes prompts, skills or rubrics.",
      "enum": ["dev", "test", "holdout"]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["zh"] }, { "required": ["en"] }],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "negative": { "$ref": "#/definitions/localized" },
        "translation": { "enum": ["manual-verified", "machine", "none"] }
      }
    },
    "assets": {
      "description": "Condition assets grouped by role. ground_truth is the reference answer (e.g. TTS target audio) and must never be the same clip as ref_audio.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref_image": { "$ref": "#/definitions/assetList" },
        "first_frame": { "$ref": "#/definitions/assetList" },
        "last_frame": { "$ref": "#/definitions/assetList" },
        "face_ref": { "$ref": "#/definitions/assetList" },
        "ref_video": { "$ref": "#/definitions/assetList" },
        "ref_audio": { "$ref": "#/definitions/assetList" },
        "ground_truth": { "$ref": "#/definitions/assetList" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect": { "type": "string", "pattern": "^\\d+(\\.\\d+)?:\\d+(\\.\\d+)?$" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "durationToleranceSec": { "type": "number", "minimum": 0 },
        "resolution": { "type": "string", "pattern": "^(\\d{3,4}p|\\d+x\\d+|[124]K)$" },
        "textToRender": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "textToSpeak": { "type": "string", "minLength": 1 },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "type": "boolean" },
            "language": { "type": "string" },
            "syncToleranceSec": { "type": "number", "minimum": 0 }
          }
        },
        "minDynamicDegree": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "checks": {
      "description": "Per-item checkable QA (Seedream 4.0 DreamEval style). parent gates a child: if the parent fails the child counts as failed.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "question"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "type": { "enum": ["vqa-yesno", "ocr-match", "audio-qa", "rule"] },
          "question": { "type": "string", "minLength": 2 },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "parent": { "type": "string" },
          "target": { "type": "string" },
          "grader": { "type": "string", "description": "For type=rule: the objective grader id in eval/aigc/graders." }
        }
      }
    },
    "rubrics": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "source": {
      "type": "object",
      "required": ["kind", "created"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["handwritten", "user-log", "public-bench", "llm-rewrite", "bad-case"] },
        "ref": { "type": "string" },
        "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewedBy": { "type": "string" },
        "dedupCluster": { "type": "string" }
      }
    }
  }
}
