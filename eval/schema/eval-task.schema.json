{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flovart.dev/schema/eval-task.schema.json",
  "title": "EvalTask",
  "description": "One FlovartBench task: instruction + environment + verifier. Never a mandatory reference trajectory.",
  "type": "object",
  "required": ["id", "version", "suite", "instruction", "expected"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "minLength": 1 },
    "suite": {
      "enum": ["workflow", "references", "provider", "production-task", "agent", "local-assets", "environment", "native-effects", "recovery"]
    },
    "split": { "enum": ["dev", "regression"] },
    "difficulty": { "enum": ["basic", "intermediate", "advanced"] },
    "instruction": { "type": "string", "minLength": 8 },
    "fixture": {
      "type": "object",
      "description": "Initial world. Ids declared here survive normalisation, so graders can address them by name.",
      "properties": {
        "project": {
          "type": "object",
          "required": ["id", "nodes", "connections", "selectedNodeIds"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "nodes": { "type": "array" },
            "connections": { "type": "array" },
            "selectedNodeIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "revision": { "type": "number" },
        "providerBehavior": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["ok", "unauthorized", "rate_limited", "timeout", "submit_response_lost", "fail_once"] },
            "paidByDefault": { "type": "boolean" },
            "seed": { "type": "number" }
          }
        },
        "grants": {
          "type": "object",
          "properties": { "folderAccess": { "type": "array", "items": { "type": "string" } } }
        },
        "declaredIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allowedSurfaces": {
      "type": "array",
      "items": { "enum": ["cli", "mcp", "oracle", "codex", "nop", "environment", "real-provider"] }
    },
    "forbiddenActions": { "type": "array", "items": { "type": "string" } },
    "expected": {
      "type": "object",
      "required": ["predicates"],
      "properties": {
        "predicates": { "type": "object", "minProperties": 1 },
        "exactCanonical": {
          "type": "string",
          "pattern": "^fnv1a_[0-9a-f]{16}$",
          "description": "Frozen canonical hash of the reference final world. Predicate grading stays on; this adds a whole-world equality assertion. Written by `node eval/run.mjs oracle --freeze-hashes` and verified by every oracle run afterwards."
        },
        "expectsRejection": { "type": "boolean" },
        "rejectionCodes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "safety": { "type": "object" },
    "solution": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "approvals": { "type": "array", "items": { "type": "string" } },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "command": { "type": "string" },
              "args": { "type": "object" },
              "idempotencyKey": { "type": "string" },
              "allowFailure": { "type": "boolean" }
            }
          }
        }
      }
    },
    "runnerScope": {
      "type": "array",
      "items": { "enum": ["oracle", "cli", "mcp", "codex", "nop", "environment", "real-provider"] },
      "description": "Runners that can express this task. A runner outside the scope is skipped and reported."
    },
    "runnerScopeReason": { "type": "string" },
    "platforms": { "type": "array", "items": { "enum": ["win32", "posix"] } },
    "knownGap": {
      "type": "string",
      "description": "Premise the product does not implement. Measured and listed, excluded from admission. Never a pass."
    },
    "timeout": { "type": "number" },
    "repeatPolicy": { "type": "object", "properties": { "runs": { "type": "number" } } },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
