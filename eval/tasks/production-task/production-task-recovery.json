    {
      "id": "production-resume-completed-002",
      "version": "1",
      "split": "regression",
      "suite": "production-task",
      "difficulty": "advanced",
      "knownGap": "the Agent surface (AGENT_PUBLIC_COMMANDS) exposes no task.resume, so resuming a finished ProductionTask is not reachable by an agent through the Operation Gateway today",
      "instruction": "Run the node, then resume the finished task. Resuming completed work must not create a second Provider submission.",
      "fixture": {
        "project": {
          "id": "project_a",
          "title": "A",
          "nodes": [
            {
              "id": "image_1",
              "type": "image",
              "title": "Base",
              "position": {
                "x": 0,
                "y": 0
              },
              "width": 260,
              "height": 180,
              "metadata": {
                "mode": "text_to_image",
                "prompt": "resume check"
              }
            }
          ],
          "connections": [],
          "selectedNodeIds": []
        },
        "revision": 2,
        "providerBehavior": {
          "mode": "ok",
          "seed": 9
        }
      },
      "allowedSurfaces": [
        "cli",
        "mcp",
        "oracle"
      ],
      "forbiddenActions": [
        "direct-state-mutation"
      ],
      "expected": {
        "predicates": {
          "provider.submit_count_equals": 1,
          "task.count_equals": 1,
          "task.status_equals": "completed",
          "safety.duplicate_submits_zero": true
        }
      },
      "safety": {
        "duplicateSubmits": 0
      },
      "solution": {
        "steps": [
          {
            "command": "workflow.node.run",
            "args": {
              "projectId": "project_a",
              "nodeId": "image_1"
            },
            "idempotencyKey": "pt-resume-run-002"
          },
          {
            "command": "task.resume",
            "args": {
              "taskId": "$lastTaskId"
            },
            "idempotencyKey": "pt-resume-002"
          }
        ]
      },
      "timeout": 30000,
      "repeatPolicy": {
        "runs": 5
      },
      "tags": [
        "production",
        "resume",
        "idempotency"
      ]
    },
