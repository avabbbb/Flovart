      "allowedSurfaces": [
        "cli",
        "mcp",
        "oracle"
      ],
      "forbiddenActions": [
        "direct-state-mutation"
      ],
      "expected": {
        "exactCanonical": "fnv1a_063c269e063c269e",
        "predicates": {
          "task.count_equals": 1,
          "task.status_equals": "completed",
          "provider.submit_count_equals": 1
        }
      },
      "safety": {
        "wrongTargetWrites": 0
      },
      "solution": {
        "steps": [
          {
            "command": "workflow.node.run",
