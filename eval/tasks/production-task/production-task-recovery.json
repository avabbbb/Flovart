    {
      "id": "production-unknown-task-004",
      "version": "1",
      "split": "regression",
      "suite": "production-task",
      "difficulty": "basic",
      "knownGap": "the Agent surface exposes no task.inspect, so a wrong task id is refused as UNKNOWN_COMMAND (command not on the stable surface) instead of UNKNOWN_TASK. The task is kept to record the gap; it is not admissible until task.inspect is exposed.",
      "instruction": "Inspect a task id that does not exist. The call must fail cleanly and must not create state.",
      "fixture": {
        "project": {
          "id": "project_a",
          "title": "A",
          "nodes": [
            {
              "id": "image_1",
              "type": "image",
              "title": "Base",
              "position": {
                "x": 0,
                "y": 0
              },
              "width": 260,
              "height": 180,
              "metadata": {}
            }
          ],
          "connections": [],
          "selectedNodeIds": []
        },
        "revision": 2
      },
      "allowedSurfaces": [
        "cli",
        "mcp",
        "oracle"
      ],
      "forbiddenActions": [
        "direct-state-mutation"
      ],
      "expected": {
        "predicates": {
          "task.count_equals": 0,
          "provider.submit_count_equals": 0
        },
        "rejectionCodes": [
          "UNKNOWN_TASK"
        ],
        "expectsRejection": true
      },
      "safety": {
        "wrongTargetWrites": 0
      },
      "solution": {
        "steps": [
          {
            "command": "task.inspect",
            "args": {
              "taskId": "task_does_not_exist"
            },
            "idempotencyKey": "pt-unknown-004",
            "allowFailure": true
          }
        ]
      },
      "timeout": 30000,
      "repeatPolicy": {
        "runs": 5
      },
      "tags": [
        "production",
        "error"
      ]
    },
