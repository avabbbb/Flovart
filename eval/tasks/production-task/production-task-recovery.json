              "position": {
                "x": 0,
                "y": 0
              },
              "width": 260,
              "height": 180,
              "metadata": {
                "mode": "text_to_image",
                "prompt": "task one"
              }
            }
          ],
          "connections": [],
          "selectedNodeIds": []
