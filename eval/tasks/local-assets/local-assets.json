      "id": "local-folder-reference-001",
      "version": "1",
      "split": "dev",
      "suite": "local-assets",
      "difficulty": "intermediate",
      "instruction": "Reference a local folder image by path without copying its bytes into the project.",
      "fixture": {
        "project": {
          "id": "project_a",
          "title": "A",
          "nodes": [],
          "connections": [],
          "selectedNodeIds": []
        },
        "revision": 1,
        "grants": {
          "folderAccess": [
            "Products"
          ]
        }
      },
      "allowedSurfaces": [
        "cli",
        "mcp",
        "oracle"
      ],
      "forbiddenActions": [
        "direct-state-mutation"
      ],
      "expected": {
        "exactCanonical": "fnv1a_8f2d07b38f2d07b3",
        "predicates": {
          "workflow.node_count_equals": 1,
          "reference.source_prefix": "local-folder:",
          "reference.local_folder_exists": "Products"
        }
      },
      "safety": {
        "wrongTargetWrites": 0
      },
      "solution": {
        "steps": [
          {
            "command": "workflow.apply",
            "args": {
              "projectId": "project_a",
              "expectedRevision": 1,
              "operations": [
                {
                  "type": "add_node",
                  "node": {
                    "id": "image_1",
                    "type": "image",
                    "title": "hero.png",
                    "position": {
                      "x": 0,
                      "y": 0
                    },
                    "metadata": {
                      "source": "local-folder:Products/hero.png",
                      "sourceType": "localFolder"
                    }
                  }
                }
              ],
              "mutationId": "local-ref-001"
            },
            "idempotencyKey": "local-ref-001"
          }
        ]
      },
      "timeout": 30000,
      "repeatPolicy": {
        "runs": 5
      },
      "tags": [
        "local-assets",
        "reference"
      ]
    },
