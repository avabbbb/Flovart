        "security"
      ]
    },
    {
      "id": "environment-discovery-posix-mode-005",
      "version": "1",
      "split": "regression",
      "suite": "environment",
      "difficulty": "intermediate",
      "instruction": "On POSIX, a discovery record readable by group or other must be rejected; 0600 must be accepted.",
      "runnerScope": [
        "environment"
      ],
      "platforms": [
        "posix"
      ],
      "fixture": {
        "project": {
          "id": "project_a",
          "title": "A",
          "nodes": [],
          "connections": [],
          "selectedNodeIds": []
        },
        "revision": 1
      },
      "allowedSurfaces": [
        "environment"
      ],
      "forbiddenActions": [
        "permission-policy-weakening"
      ],
      "expected": {
        "predicates": {
          "runtime.discovery_verdicts": [
            {
              "scenario": "posix-strict",
              "verdict": "accept"
            },
            {
              "scenario": "posix-broad",
              "verdict": "reject"
            }
          ]
        }
      },
      "solution": {
        "steps": [
          {
            "command": "runtime.discovery.verify",
            "args": {
              "scenario": "posix-strict",
              "platform": "posix",
              "expect": "accept",
              "acl": {
                "mode": 384
              }
            }
          },
          {
            "command": "runtime.discovery.verify",
            "args": {
              "scenario": "posix-broad",
              "platform": "posix",
              "expect": "reject",
              "acl": {
                "mode": 420
              }
            }
          }
        ]
      },
      "timeout": 60000,
      "repeatPolicy": {
        "runs": 5
      },
      "tags": [
        "environment",
        "runtime",
        "posix"
      ]
    }
  ]
}
