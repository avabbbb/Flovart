      "difficulty": "hard"
    },
    {
      "id": "gold",
      "type": "vqa-yesno",
      "question": "文字是否为金色？",
      "parent": "text",
      "difficulty": "medium"
    },
    {
      "id": "ribbons",
      "type": "vqa-yesno",
      "question": "周围是否有彩带？",
      "difficulty": "easy"
    },
    {
      "id": "square",
      "type": "rule",
      "question": "画面为 1:1",
      "grader": "aspect"
    }
  ],
  "rubrics": [
    "image-output"
  ],
